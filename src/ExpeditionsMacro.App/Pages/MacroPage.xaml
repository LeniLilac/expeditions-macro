<UserControl x:Class="ExpeditionsMacro.App.Pages.MacroPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls">
    <Grid>
        <ScrollViewer x:Name="DashboardScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <Grid MinWidth="1148"
                  Margin="34,27,40,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Dashboard" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" icons:Lucide.Icon="Play" Content="Start plan  F6" Click="Start_Click" />
                        <Button x:Name="StopButton" Margin="8,0,0,0" Style="{StaticResource DangerButton}" icons:Lucide.Icon="Square" Content="Stop plan  F6" IsEnabled="False" Click="Stop_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="274" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource FormCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Roblox live view" />
                                <CheckBox x:Name="PinRobloxCheck"
                                          HorizontalAlignment="Right"
                                          IsChecked="True"
                                          Content="Pinned"
                                          Checked="PinRoblox_Changed"
                                          Unchecked="PinRoblox_Changed" />
                            </Grid>
                            <icons:RobloxDashboardPreview x:Name="RobloxPreview"
                                                          Grid.Row="1"
                                                          Margin="0,14,0,0"
                                                          ToolTip="The interactive Roblox window is pinned here while Dashboard is visible." />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource FormCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Current run" />
                            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                <TextBlock x:Name="PhaseText" FontSize="15" FontWeight="SemiBold" Text="Ready to run a saved plan." TextWrapping="Wrap" />
                                <TextBlock x:Name="CurrentTaskText" Margin="0,5,0,0" Style="{StaticResource Caption}" Text="Current task: none" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,22,0,0">
                                <TextBlock Style="{StaticResource Caption}" Text="Runtime" />
                                <TextBlock x:Name="RuntimeText" Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" Text="00:00:00" />
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="Victories" />
                                        <TextBlock x:Name="VictoriesText" Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Text="0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource Caption}" Text="Defeats" />
                                        <TextBlock x:Name="DefeatsText" Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" Text="0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <ProgressBar x:Name="MacroProgress" Grid.Row="3" Margin="0,20,0,0" Minimum="0" Maximum="100" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource FormCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Run log" />
                        <Border MinHeight="150" Margin="0,14,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" BorderThickness="0" FontSize="11" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource FormCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Discord notifications" />
                            <TextBlock Margin="0,18,0,0" Style="{StaticResource FieldLabel}" Text="Webhook link" />
                            <Border Margin="0,7,0,0" Style="{StaticResource InputGroup}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="WebhookPassword" Style="{StaticResource InputGroupPasswordBox}" />
                                    <TextBox x:Name="WebhookVisible" Style="{StaticResource InputGroupTextBox}" Visibility="Collapsed" />
                                    <Button x:Name="TestWebhookButton" Grid.Column="1" Height="32" Margin="4" icons:Lucide.Icon="Send" Content="Test webhook" Click="TestWebhook_Click" />
                                    <CheckBox x:Name="ShowWebhookCheck" Grid.Column="2" Margin="4" Style="{StaticResource RevealToggle}" AutomationProperties.Name="Show webhook link" ToolTip="Show or hide webhook link" Checked="ShowWebhook_Changed" Unchecked="ShowWebhook_Changed" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="WebhookStatusText" Margin="0,8,0,0" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
                        <StackPanel Grid.Column="2" Margin="24,0,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Failure alert ping" />
                            <TextBlock Margin="0,18,0,0" Style="{StaticResource FieldLabel}" Text="Discord user ID" />
                            <TextBox x:Name="DiscordUserIdText" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource FormCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Roblox reconnect" />
                        <CheckBox x:Name="RestartRobloxAtStartCheck" Margin="0,14,0,0" Content="Restart Roblox through this private server when a Macro plan starts" />
                        <CheckBox x:Name="RestartRobloxCheck" Margin="0,14,0,0" Content="Restart Roblox through this private server when recovery fails" />
                        <TextBlock Margin="0,18,0,0" Style="{StaticResource FieldLabel}" Text="Private server link" />
                        <Border Margin="0,7,0,0" Style="{StaticResource InputGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PrivateServerLinkPassword" Style="{StaticResource InputGroupPasswordBox}" />
                                <TextBox x:Name="PrivateServerLinkVisible" Style="{StaticResource InputGroupTextBox}" Visibility="Collapsed" />
                                <Button x:Name="TestPrivateServerButton" Grid.Column="1" Height="32" Margin="4" icons:Lucide.Icon="ExternalLink" Content="Test link" Click="TestPrivateServer_Click" />
                                <CheckBox x:Name="ShowPrivateServerLinkCheck" Grid.Column="2" Margin="4" Style="{StaticResource RevealToggle}" AutomationProperties.Name="Show private server link" ToolTip="Show or hide private server link" Checked="ShowPrivateServerLink_Changed" Unchecked="ShowPrivateServerLink_Changed" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PrivateServerStatusText" Margin="0,7,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Margin="0,14,0,0" Style="{StaticResource FormCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Macro preparation" />
                        </StackPanel>
                        <CheckBox x:Name="DashboardAutoGameSettingsCheck"
                                  Grid.Column="1"
                                  Content="Check and fix game settings at macro start"
                                  Checked="DashboardAutoGameSettingsCheck_Changed"
                                  Unchecked="DashboardAutoGameSettingsCheck_Changed" />
                    </Grid>
                </Border>

                <Border Grid.Row="6" Margin="0,14,0,0" Style="{StaticResource FormCard}">
                    <icons:SettingsKeyBindingsPanel x:Name="DashboardKeyBindingsPanel" />
                </Border>
            </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="PlanScroll"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="34,27,40,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Margin="0,0,0,20" Style="{StaticResource PageTitle}" Text="Macro Plan" />

                <Border Grid.Row="1" Style="{StaticResource FormCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Text="Plan" />
                        <ComboBox x:Name="PlanCombo" Grid.Column="1" DisplayMemberPath="Name" SelectionChanged="PlanCombo_SelectionChanged" />
                        <TextBox x:Name="PlanNameText" Grid.Column="3" Text="Daily rotation" />
                        <Button Grid.Column="4" Margin="8,0,0,0" icons:Lucide.Icon="Save" Content="Save plan" Click="SavePlan_Click" />
                        <Button Grid.Column="5" Margin="8,0,0,0" icons:Lucide.Icon="Plus" Content="New" Click="NewPlan_Click" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource FormCard}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Plan blocks" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="Priority runs from top to bottom. A live match is never interrupted." />
                            </StackPanel>
                            <Button x:Name="ResetProgressButton" HorizontalAlignment="Right" Height="34" icons:Lucide.Icon="RotateCcw" Content="Reset progress" Click="ResetProgress_Click" />
                        </Grid>

                        <Border Margin="0,16,0,0" Padding="13" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" Background="{DynamicResource AccentBrush}" CornerRadius="14">
                                    <icons:LucideIcon Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OnAccentBrush}" Icon="Play" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="When the plan starts" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}" Text="Run the first eligible block, then re-evaluate priority after each match." />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Width="2" Height="10" Margin="27,0,0,0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" />

                        <icons:MacroPlanLoopEditor x:Name="LoopEditor" />

                        <ItemsControl x:Name="TaskRowsControl"
                                      Visibility="Collapsed" />
                        <TextBlock x:Name="EmptyTasksText" Margin="14,10" Style="{StaticResource Caption}" Text="No blocks yet. Build the plan below." />

                        <Border Margin="0,10,0,0" Padding="14" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Add a block" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="136" />
                                        <ColumnDefinition x:Name="TaskSelectionGapColumn" Width="16" />
                                        <ColumnDefinition x:Name="TaskSelectionColumn" Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="124" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mode" />
                                        <ComboBox x:Name="TaskKindCombo" Margin="0,7,0,0" DisplayMemberPath="Name" SelectionChanged="TaskKindCombo_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel x:Name="TaskSelectionPanel" Grid.Column="2">
                                        <TextBlock x:Name="TaskSelectionLabel" Style="{StaticResource FieldLabel}" Text="Preset" />
                                        <Grid Margin="0,7,0,0">
                                            <ComboBox x:Name="TaskPresetCombo" DisplayMemberPath="DisplayName" SelectionChanged="TaskPresetCombo_SelectionChanged" />
                                            <ComboBox x:Name="TaskRouteCombo" DisplayMemberPath="Name" Visibility="Collapsed" SelectionChanged="TaskRouteCombo_SelectionChanged" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock x:Name="TaskTargetLabel" Style="{StaticResource FieldLabel}" Text="Victories" />
                                        <TextBox x:Name="TaskTargetText" Margin="0,7,0,0" Text="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="State" />
                                        <CheckBox x:Name="TaskEnabledCheck" Margin="0,7,0,0" IsChecked="True" Content="Enabled" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="8" Margin="0,21,0,0" Orientation="Horizontal">
                                        <Button x:Name="AddTaskButton" Style="{StaticResource PrimaryButton}" icons:Lucide.Icon="Plus" Content="Add block" Click="AddOrUpdateTask_Click" />
                                        <Button x:Name="CancelTaskEditButton" Height="40" Margin="8,0,0,0" Visibility="Collapsed" icons:Lucide.Icon="X" Content="Cancel" Click="CancelTaskEdit_Click" />
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="FastTaskOptionsPanel" Margin="0,16,0,0" Padding="0,14,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                                    <WrapPanel>
                                        <StackPanel x:Name="TaskDefeatRetriesPanel" Width="124" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Defeat retries" />
                                            <TextBox x:Name="TaskDefeatRetriesText" Margin="0,7,0,0" Text="0" />
                                        </StackPanel>
                                        <StackPanel x:Name="TaskChallengeTypesPanel" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Challenge types" />
                                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                                <CheckBox x:Name="TaskTraitCheck" Margin="0" IsChecked="True" Content="Trait" />
                                                <CheckBox x:Name="TaskStatCheck" Margin="14,0,0,0" IsChecked="True" Content="Stat" />
                                                <CheckBox x:Name="TaskSpriteCheck" Margin="14,0,0,0" IsChecked="True" Content="Sprite" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="TaskExpeditionOptionsPanel" Orientation="Horizontal">
                                            <StackPanel Width="110" Margin="0,0,16,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Difficulty" />
                                                <ComboBox x:Name="TaskDifficultyCombo" Margin="0,7,0,0" />
                                            </StackPanel>
                                            <StackPanel Width="174" Margin="0,0,16,0">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Extraction" />
                                                <CheckBox x:Name="TaskExtractCheck" Margin="0,7,0,0" IsChecked="True" Content="Extract at checkpoint" />
                                            </StackPanel>
                                            <StackPanel Width="164">
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Boss nodes before extract" />
                                                <TextBox x:Name="TaskBossNodesText" Margin="0,7,0,0" Text="1" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="TaskStoryOptionsPanel" Width="150">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Story options" />
                                            <CheckBox x:Name="TaskHardModeCheck" Margin="0,7,0,0" Content="Hard mode" />
                                        </StackPanel>
                                    </WrapPanel>
                                </Border>
                                <TextBlock x:Name="TaskEditorStatusText" Margin="0,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="SharePlanCard" Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource FormCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Share config" />
                        <TextBox x:Name="ShareCodeText" Grid.Row="1" Height="68" Margin="0,14,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock x:Name="SharePlanStatusText" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="ExportPlanCodeButton" icons:Lucide.Icon="Send" Content="Export code" Click="ExportPlanCode_Click" />
                                <Button x:Name="CopyPlanCodeButton" Margin="8,0,0,0" icons:Lucide.Icon="Copy" Content="Copy" Click="CopyPlanCode_Click" />
                                <Button x:Name="ImportPlanCodeButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" icons:Lucide.Icon="FolderOpen" Content="Import code" Click="ImportPlanCode_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
