<UserControl x:Class="ExpeditionsMacro.App.Pages.PlacementModelsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls"
             xmlns:models="clr-namespace:ExpeditionsMacro.App.Models"
             PreviewKeyDown="PlacementModelsPage_PreviewKeyDown">
    <UserControl.Resources>
        <DataTemplate x:Key="PlacementSetupNodeTemplate"
                      DataType="{x:Type models:PlacementSetupNode}">
            <Grid x:Name="SetupRoot"
                  MinHeight="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="SetupName"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SetupStatus"
                           Grid.Row="1"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource FaintBrush}"
                           Text="{Binding Status}"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="DisclosureButton"
                        Grid.Column="1"
                        Grid.RowSpan="2"
                        Width="28"
                        Height="28"
                        MinWidth="28"
                        Margin="4,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Focusable="False"
                        Visibility="Collapsed"
                        Style="{StaticResource IconButton}"
                        icons:Lucide.Icon="ChevronRight"
                        ToolTip="Show routes"
                        Click="FastSetupDisclosure_Click" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGroup}"
                             Value="True">
                    <Setter TargetName="SetupName"
                            Property="FontSize"
                            Value="12" />
                    <Setter TargetName="SetupName"
                            Property="FontWeight"
                            Value="SemiBold" />
                    <Setter TargetName="SetupName"
                            Property="Foreground"
                            Value="{DynamicResource TextBrush}" />
                    <Setter TargetName="DisclosureButton"
                            Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsChild}"
                             Value="True">
                    <Setter TargetName="SetupRoot"
                            Property="Margin"
                            Value="18,0,0,0" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsGroup}"
                                   Value="True" />
                        <Condition Binding="{Binding IsExpanded}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="DisclosureButton"
                            Property="icons:Lucide.Icon"
                            Value="ChevronDown" />
                    <Setter TargetName="DisclosureButton"
                            Property="ToolTip"
                            Value="Hide routes" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsGroup}"
                             Value="True">
                    <Setter TargetName="SetupRoot"
                            Property="MinHeight"
                            Value="38" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CatalogColumn"
                              Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="CatalogRail"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid x:Name="CatalogLayout"
                  Margin="12,18,12,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="CatalogHeader"
                      Margin="6,0,6,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModelsHeaderText"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="PLACEMENT SETUP" />
                    <Button x:Name="CatalogRailToggleButton"
                            Grid.Column="1"
                            Width="32"
                            MinWidth="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            Style="{StaticResource IconButton}"
                            icons:Lucide.Icon="Menu"
                            ToolTip="Collapse placement routes"
                            AutomationProperties.Name="Collapse placement routes"
                            Click="CatalogRailToggle_Click" />
                </Grid>
                <ListBox x:Name="FastSetupList"
                         Grid.Row="1"
                         ItemTemplate="{StaticResource PlacementSetupNodeTemplate}"
                         SelectionChanged="FastSetupList_SelectionChanged" />
            </Grid>
        </Border>
        <icons:PlacementFastEditorView x:Name="FastEditorPanel"
                                       Grid.Column="1"
                                       Margin="24,20,28,24" />
        <Grid x:Name="MatchSettingsOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="30"
              Background="{DynamicResource ModalScrimBrush}"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle"
              PreviewKeyDown="MatchSettingsOverlay_PreviewKeyDown"
              Visibility="Collapsed">
            <icons:PlacementTimingPopover x:Name="MatchSettingsDialog"
                                          Margin="24"
                                          HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="MatchStepEditorOverlay"
              Grid.ColumnSpan="2"
              Panel.ZIndex="31"
              Background="{DynamicResource ModalScrimBrush}"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle"
              PreviewKeyDown="MatchStepEditorOverlay_PreviewKeyDown"
              Visibility="Collapsed">
            <icons:PlacementStepEditorPopover x:Name="MatchStepEditorDialog"
                                               Margin="24"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
