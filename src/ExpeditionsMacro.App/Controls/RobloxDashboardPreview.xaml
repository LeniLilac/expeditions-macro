<UserControl x:Class="ExpeditionsMacro.App.Controls.RobloxDashboardPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls"
             Loaded="Preview_Loaded"
             Unloaded="Preview_Unloaded">
    <Border Width="810"
            Height="613"
            HorizontalAlignment="Left"
            Background="#050506"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="5"
            ClipToBounds="True">
        <Grid x:Name="PinTarget"
              Width="808"
              Height="611"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <StackPanel x:Name="PlaceholderPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <icons:LucideIcon Width="28"
                                  Height="28"
                                  HorizontalAlignment="Center"
                                  Foreground="{DynamicResource FaintBrush}"
                                  Icon="ScanSearch" />
                <TextBlock x:Name="PreviewStatusText"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="Waiting for Roblox."
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
