<UserControl x:Class="ExpeditionsMacro.App.Controls.MacroPlanLoopEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls"
             xmlns:models="clr-namespace:ExpeditionsMacro.App.Models"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             PreviewMouseMove="Editor_PreviewMouseMove"
             PreviewMouseLeftButtonUp="Editor_PreviewMouseLeftButtonUp"
             LostMouseCapture="Editor_LostMouseCapture">
    <Grid>
        <StackPanel>
        <TreeView x:Name="StructureTree"
                  Padding="0"
                  AllowDrop="True"
                  Background="Transparent"
                  BorderThickness="0"
                  Drop="Root_Drop"
                  DragOver="Root_DragOver">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="4" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="4" />
                                    </Grid.RowDefinitions>
                                    <Border Height="4"
                                            AllowDrop="True"
                                            Background="Transparent"
                                            Tag="Before"
                                            Drop="SiblingZone_Drop"
                                            DragLeave="SiblingZone_DragLeave"
                                            DragOver="SiblingZone_DragOver" />
                                    <Border x:Name="BlockCard"
                                            Grid.Row="1"
                                            Padding="8,5"
                                            Background="{DynamicResource RaisedBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <StackPanel>
                                            <ContentPresenter ContentSource="Header" />
                                            <Border x:Name="ChildrenConnector"
                                                    Margin="26,6,0,0"
                                                    Padding="6,6,6,1"
                                                    AllowDrop="True"
                                                    Background="{DynamicResource RaisedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Tag="{Binding}"
                                                    Drop="LoopContents_Drop"
                                                    DragOver="LoopContents_DragOver">
                                                <ItemsPresenter />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="2"
                                            Height="4"
                                            AllowDrop="True"
                                            Background="Transparent"
                                            Tag="After"
                                            Drop="SiblingZone_Drop"
                                            DragLeave="SiblingZone_DragLeave"
                                            DragOver="SiblingZone_DragOver" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="ChildrenConnector"
                                                Property="Visibility"
                                                Value="Collapsed" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsLoop}"
                                                 Value="True">
                                        <Setter TargetName="BlockCard"
                                                Property="Padding"
                                                Value="8" />
                                        <Setter TargetName="BlockCard"
                                                Property="Background"
                                                Value="{DynamicResource SurfaceBrush}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type models:MacroPlanLoopBlockNode}"
                                          ItemsSource="{Binding Children}">
                    <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Width="24"
                                        MinWidth="24"
                                        Height="28"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="SizeAll"
                                        Tag="{Binding}"
                                        ToolTip="Drag loop. Arrow keys reorder; Alt+Left/Right changes nesting."
                                        AutomationProperties.Name="Move loop block"
                                        PreviewKeyDown="DragHandle_PreviewKeyDown"
                                        PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                                    <icons:LucideIcon Width="15"
                                                     Height="15"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource FaintBrush}"
                                                     Icon="GripVertical" />
                                </Button>
                                <TextBlock Grid.Column="1"
                                           Margin="3,0,14,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding BlockLabel}" />
                                <TextBlock Grid.Column="2"
                                           Margin="0,0,14,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding StatusText}"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="3"
                                        Width="30"
                                        MinWidth="30"
                                        Height="30"
                                        Margin="0,0,5,0"
                                        Padding="0"
                                        Style="{StaticResource IconButton}"
                                        Tag="{Binding}"
                                        ToolTip="Add a task directly to this loop"
                                        AutomationProperties.Name="Add task to loop"
                                        icons:Lucide.Icon="Plus"
                                        Click="AddTaskToLoop_Click" />
                                <Button Grid.Column="4"
                                        Width="30"
                                        MinWidth="30"
                                        Height="30"
                                        Margin="0,0,5,0"
                                        Padding="0"
                                        Style="{StaticResource IconButton}"
                                        Tag="{Binding}"
                                        ToolTip="Edit loop settings"
                                        AutomationProperties.Name="Edit loop settings"
                                        icons:Lucide.Icon="Settings"
                                        Click="EditLoopSettings_Click" />
                                <Button Grid.Column="5"
                                        Width="30"
                                        MinWidth="30"
                                        Height="30"
                                        Padding="0"
                                        Style="{StaticResource IconButton}"
                                        Tag="{Binding}"
                                        ToolTip="Remove loop and keep its contents"
                                        AutomationProperties.Name="Remove loop and keep contents"
                                        icons:Lucide.Icon="Trash2"
                                        Click="RemoveLoop_Click" />
                            </Grid>

                            <Border x:Name="EmptyLoopDropHint"
                                    Margin="26,6,0,0"
                                    Padding="7,5"
                                    AllowDrop="True"
                                    Background="{DynamicResource RaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Tag="{Binding}"
                                    Visibility="{Binding EmptyDropVisibility}"
                                    Drop="LoopContents_Drop"
                                    DragOver="LoopContents_DragOver">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource Caption}"
                                           Text="Drop task or loop inside" />
                            </Border>
                        </StackPanel>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type models:MacroPlanTaskBlockNode}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="66" />
                            </Grid.ColumnDefinitions>
                            <Button Width="24"
                                    MinWidth="24"
                                    Height="28"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="SizeAll"
                                    Tag="{Binding}"
                                    ToolTip="Drag task. Arrow keys reorder; Alt+Left/Right changes nesting."
                                    AutomationProperties.Name="Move task block"
                                    PreviewKeyDown="DragHandle_PreviewKeyDown"
                                    PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                                <icons:LucideIcon Width="15"
                                                 Height="15"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource FaintBrush}"
                                                 Icon="GripVertical" />
                            </Button>
                            <Border Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="12">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           Text="{Binding Order}" />
                            </Border>
                            <TextBlock Grid.Column="2"
                                       Margin="6,0,9,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding Type}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="3"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding Target}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="4"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Caption}"
                                       Text="{Binding Status}"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="5"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Width="30"
                                        MinWidth="30"
                                        Height="30"
                                        Style="{StaticResource IconButton}"
                                        Tag="{Binding TaskRow}"
                                        ToolTip="Edit block"
                                        AutomationProperties.Name="Edit block"
                                        icons:Lucide.Icon="Pencil"
                                        Click="EditTask_Click" />
                                <Button Width="30"
                                        MinWidth="30"
                                        Height="30"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource IconButton}"
                                        Tag="{Binding TaskRow}"
                                        ToolTip="Remove block"
                                        AutomationProperties.Name="Remove block"
                                        icons:Lucide.Icon="Trash2"
                                        Click="RemoveTask_Click" />
                            </StackPanel>
                        </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <Border x:Name="RootDropZone"
                Margin="0,1,0,0"
                Padding="7,5"
                AllowDrop="True"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Drop="Root_Drop"
                DragOver="Root_DragOver">
            <TextBlock HorizontalAlignment="Center"
                       Style="{StaticResource Caption}"
                       Text="Drop here to move a block to the plan level" />
        </Border>

        <TextBlock x:Name="LoopValidationText"
                   Margin="0,5,0,0"
                   AutomationProperties.LiveSetting="Polite"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" />
        </StackPanel>

        <primitives:Popup x:Name="LoopSettingsPopup"
                          AllowsTransparency="True"
                          Placement="Custom"
                          StaysOpen="False"
                          Closed="LoopSettingsPopup_Closed">
            <icons:MacroLoopSettingsDialog x:Name="LoopSettingsDialog" />
        </primitives:Popup>
    </Grid>
</UserControl>
