<UserControl x:Class="ExpeditionsMacro.App.Controls.MacroPlanLoopEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls"
             xmlns:models="clr-namespace:ExpeditionsMacro.App.Models">
    <StackPanel>
        <Grid>
            <StackPanel x:Name="LoopHeading">
                <TextBlock Style="{StaticResource SectionTitle}"
                           Text="Loops" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Caption}"
                           Text="Drag tasks or whole loop blocks into a loop. Nesting is limited to three levels."
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="AddLoopButton"
                    Height="34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    icons:Lucide.Icon="Plus"
                    Content="Add loop block"
                    Click="AddLoop_Click" />
        </Grid>

        <TreeView x:Name="StructureTree"
                  Margin="0,10,0,0"
                  Padding="0"
                  AllowDrop="True"
                  Background="Transparent"
                  BorderThickness="0"
                  Drop="Root_Drop"
                  DragOver="Root_DragOver">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <StackPanel>
                                    <ContentPresenter ContentSource="Header" />
                                    <Border x:Name="ChildrenConnector"
                                            Margin="22,5,0,0"
                                            Padding="14,0,0,0"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1,0,0,0">
                                        <ItemsPresenter />
                                    </Border>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="ChildrenConnector"
                                                Property="Visibility"
                                                Value="Collapsed" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type models:MacroPlanLoopBlockNode}"
                                          ItemsSource="{Binding Children}">
                    <Border Padding="11"
                            AllowDrop="True"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            DataContext="{Binding}"
                            Drop="Block_Drop"
                            DragOver="Block_DragOver">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28"
                                        Height="28"
                                        Cursor="SizeAll"
                                        Tag="{Binding}"
                                        ToolTip="Drag this entire loop block"
                                        PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                                        PreviewMouseMove="DragHandle_MouseMove">
                                    <icons:LucideIcon Width="16"
                                                     Height="16"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource MutedTextBrush}"
                                                     Icon="GripVertical" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding BlockLabel}" />
                                <CheckBox Grid.Column="2"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="Forever"
                                          IsChecked="{Binding Forever}" />
                                <Button Grid.Column="3"
                                        Width="34"
                                        Height="30"
                                        Padding="0"
                                        Tag="{Binding}"
                                        ToolTip="Remove loop and keep its contents"
                                        icons:Lucide.Icon="Trash2"
                                        Click="RemoveLoop_Click" />
                            </Grid>

                            <Grid Margin="34,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource Caption}"
                                           Text="Runs"
                                           Visibility="{Binding FiniteControlsVisibility}" />
                                <TextBox Grid.Column="1"
                                         Margin="8,0,0,0"
                                         Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding FiniteControlsVisibility}" />
                                <TextBlock Grid.Column="2"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding StatusText}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Margin="34,8,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="{Binding MembershipText}"
                                       TextWrapping="Wrap" />

                            <Border Margin="34,9,0,0"
                                    Padding="8,6"
                                    AllowDrop="True"
                                    Background="{DynamicResource RaisedBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Tag="{Binding}"
                                    Drop="LoopContents_Drop"
                                    DragOver="LoopContents_DragOver">
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource Caption}"
                                           Text="Drop task or loop inside" />
                            </Border>
                        </StackPanel>
                    </Border>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type models:MacroPlanTaskBlockNode}">
                    <Border Padding="11,9"
                            AllowDrop="True"
                            Background="{DynamicResource RaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Drop="Block_Drop"
                            DragOver="Block_DragOver">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="78" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    Cursor="SizeAll"
                                    Tag="{Binding}"
                                    ToolTip="Drag task block"
                                    PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                                    PreviewMouseMove="DragHandle_MouseMove">
                                <icons:LucideIcon Width="16"
                                                 Height="16"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource MutedTextBrush}"
                                                 Icon="GripVertical" />
                            </Border>
                            <Border Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="14">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentBrush}"
                                           Text="{Binding Order}" />
                            </Border>
                            <TextBlock Grid.Column="2"
                                       Margin="7,0,10,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding Type}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="3"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource Caption}"
                                           Text="{Binding Target}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="4"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Caption}"
                                       Text="{Binding Status}"
                                       TextWrapping="Wrap" />
                            <StackPanel Grid.Column="5"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button Width="34"
                                        MinWidth="34"
                                        Height="34"
                                        Style="{StaticResource IconButton}"
                                        Tag="{Binding TaskRow}"
                                        ToolTip="Edit block"
                                        AutomationProperties.Name="Edit block"
                                        icons:Lucide.Icon="Pencil"
                                        Click="EditTask_Click" />
                                <Button Width="34"
                                        MinWidth="34"
                                        Height="34"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource IconButton}"
                                        Tag="{Binding TaskRow}"
                                        ToolTip="Remove block"
                                        AutomationProperties.Name="Remove block"
                                        icons:Lucide.Icon="Trash2"
                                        Click="RemoveTask_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <Border x:Name="RootDropZone"
                Margin="0,2,0,0"
                Padding="8,7"
                AllowDrop="True"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Drop="Root_Drop"
                DragOver="Root_DragOver">
            <TextBlock HorizontalAlignment="Center"
                       Style="{StaticResource Caption}"
                       Text="Drop here to move a block to the plan level" />
        </Border>

        <TextBlock x:Name="LoopValidationText"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
