<UserControl x:Class="ExpeditionsMacro.App.Controls.MacroPlanLoopEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="14"
            Background="{DynamicResource RaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="142" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="116" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Loop" />
                <CheckBox x:Name="LoopEnabledCheck"
                          Margin="0,7,0,0"
                          Content="Enabled"
                          Checked="Control_Changed"
                          Unchecked="Control_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Loop start" />
                <ComboBox x:Name="LoopStartCombo"
                          Margin="0,7,0,0"
                          DisplayMemberPath="LoopLabel"
                          SelectionChanged="Selection_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Loop stop" />
                <ComboBox x:Name="LoopStopCombo"
                          Margin="0,7,0,0"
                          DisplayMemberPath="LoopLabel"
                          SelectionChanged="Selection_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Amount" />
                <TextBox x:Name="LoopAmountText"
                         Margin="0,7,0,0"
                         Text="2"
                         TextChanged="Amount_Changed" />
            </StackPanel>
            <StackPanel Grid.Column="8">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Duration" />
                <CheckBox x:Name="LoopForeverCheck"
                          Margin="0,7,0,0"
                          Content="Forever"
                          Checked="Control_Changed"
                          Unchecked="Control_Changed" />
            </StackPanel>
            <TextBlock x:Name="LoopStatusText"
                       Grid.Row="1"
                       Grid.ColumnSpan="9"
                       Margin="0,9,0,0"
                       Style="{StaticResource Caption}"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
