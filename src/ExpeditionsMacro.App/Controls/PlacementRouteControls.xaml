<UserControl x:Class="ExpeditionsMacro.App.Controls.PlacementRouteControls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="5">
        <WrapPanel>
            <StackPanel Width="180"
                        Margin="0,0,18,8">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Team" />
                <ComboBox x:Name="TeamCombo"
                          Margin="0,7,0,0"
                          AutomationProperties.Name="Team"
                          DisplayMemberPath="Name" />
            </StackPanel>
            <StackPanel x:Name="PhasePanel"
                        Margin="0,0,18,8">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Placement phase" />
                <StackPanel Margin="0,7,0,0"
                            Orientation="Horizontal">
                    <RadioButton x:Name="BeforeStartButton"
                                 GroupName="PlacementPhase"
                                 Style="{StaticResource PlacementChoiceButton}"
                                 Content="Before Start"
                                 Tag="BeforeStart"
                                 IsChecked="True"
                                 Checked="PhaseButton_Checked" />
                    <RadioButton x:Name="AfterStartButton"
                                 GroupName="PlacementPhase"
                                 Style="{StaticResource PlacementChoiceButton}"
                                 Content="After Start"
                                 Tag="AfterStart"
                                 Checked="PhaseButton_Checked" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="UnitPanel"
                        Margin="0,0,0,8">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Unit slot" />
                <StackPanel Margin="0,7,0,0"
                            Orientation="Horizontal">
                    <RadioButton x:Name="Unit1Button" GroupName="PlacementUnit"
                                 Style="{StaticResource PlacementChoiceButton}" Width="42" MinWidth="42"
                                 Padding="0" Content="1" Tag="1" IsChecked="True" Checked="UnitButton_Checked" />
                    <RadioButton x:Name="Unit2Button" GroupName="PlacementUnit"
                                 Style="{StaticResource PlacementChoiceButton}" Width="42" MinWidth="42"
                                 Padding="0" Content="2" Tag="2" Checked="UnitButton_Checked" />
                    <RadioButton x:Name="Unit3Button" GroupName="PlacementUnit"
                                 Style="{StaticResource PlacementChoiceButton}" Width="42" MinWidth="42"
                                 Padding="0" Content="3" Tag="3" Checked="UnitButton_Checked" />
                    <RadioButton x:Name="Unit4Button" GroupName="PlacementUnit"
                                 Style="{StaticResource PlacementChoiceButton}" Width="42" MinWidth="42"
                                 Padding="0" Content="4" Tag="4" Checked="UnitButton_Checked" />
                    <RadioButton x:Name="Unit5Button" GroupName="PlacementUnit"
                                 Style="{StaticResource PlacementChoiceButton}" Width="42" MinWidth="42"
                                 Padding="0" Content="5" Tag="5" Checked="UnitButton_Checked" />
                    <RadioButton x:Name="Unit6Button" GroupName="PlacementUnit"
                                 Style="{StaticResource PlacementChoiceButton}" Width="42" MinWidth="42"
                                 Padding="0" Content="6" Tag="6" Checked="UnitButton_Checked" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="RecordingPanel"
                        MinWidth="280"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}"
                           Text="Recording" />
                <ComboBox x:Name="RecordingCombo"
                          MinWidth="280"
                          Margin="0,7,0,0"
                          HorizontalAlignment="Stretch"
                          AutomationProperties.Name="Manual recording"
                          DisplayMemberPath="Name"
                          SelectionChanged="RecordingCombo_SelectionChanged" />
            </StackPanel>
        </WrapPanel>
    </Border>
</UserControl>
