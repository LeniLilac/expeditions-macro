<UserControl x:Class="ExpeditionsMacro.App.Controls.PlacementFastEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls"
             xmlns:models="clr-namespace:ExpeditionsMacro.App.Models"
             SizeChanged="Editor_SizeChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="PlacementMarkerTemplate">
            <Canvas Width="66"
                    Height="46"
                    Cursor="Hand"
                    ToolTip="Right-click to remove this placement"
                    MouseLeftButtonDown="PlacementMarker_MouseLeftButtonDown"
                    MouseRightButtonDown="PlacementMarker_MouseRightButtonDown">
                <Canvas.RenderTransform>
                    <TranslateTransform X="-8"
                                        Y="-38" />
                </Canvas.RenderTransform>
                <Path x:Name="MarkerConnector"
                      Data="M 8,34 L 8,12 L 18,12"
                      Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="3" />
                <Ellipse x:Name="MarkerPoint"
                         Canvas.Left="1"
                         Canvas.Top="27"
                         Width="14"
                         Height="14"
                         Fill="{DynamicResource SurfaceBrush}"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="4" />
                <Border x:Name="MarkerLabelBox"
                        Canvas.Left="18"
                        Canvas.Top="0"
                        MinWidth="36"
                        Height="24"
                        Padding="8,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="3">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock FontWeight="Bold"
                                   Text="{Binding MarkerLabel}" />
                        <TextBlock Margin="4,0,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding PhaseShortLabel}" />
                    </StackPanel>
                </Border>
            </Canvas>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Phase}"
                             Value="AfterStart">
                    <Setter TargetName="MarkerConnector"
                            Property="Stroke"
                            Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="MarkerPoint"
                            Property="Stroke"
                            Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="MarkerLabelBox"
                            Property="BorderBrush"
                            Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="PlacementStepTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Margin="-2,0,4,0"
                        Padding="0,2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="SizeAll"
                        ToolTip="Drag to reorder within this placement phase"
                        PreviewMouseLeftButtonDown="StepDragHandle_PreviewMouseLeftButtonDown">
                    <icons:LucideIcon Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Foreground="{DynamicResource FaintBrush}"
                                      Icon="GripVertical" />
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding UnitKey, StringFormat='Unit {0}'}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding PhaseLabel}" />
                    </Grid>
                    <TextBlock Grid.Row="2"
                               Style="{StaticResource Caption}">
                        <TextBlock.Inlines>
                            <Run Text="Coordinate " />
                            <Run Text="{Binding X, Mode=OneWay}" />
                            <Run Text=", " />
                            <Run Text="{Binding Y, Mode=OneWay}" />
                        </TextBlock.Inlines>
                    </TextBlock>
                    <StackPanel Grid.Row="4">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Targeting priority" />
                        <ComboBox Margin="0,5,0,0"
                                  ItemsSource="{x:Static models:PlacementStepRow.TargetingPriorities}"
                                  SelectedItem="{Binding TargetingPriority, Mode=TwoWay}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource FieldLabel}" Text="Auto upgrade" />
                            <CheckBox Grid.Column="2" Style="{StaticResource PlacementBinaryChoiceButton}"
                                      AutomationProperties.Name="Auto upgrade" AutomationProperties.HelpText="Press Space to switch auto upgrade off or on."
                                      IsChecked="{Binding AutoUpgrade, Mode=TwoWay}"
                                      ToolTip="Choose whether this unit upgrades automatically."/>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="StepAfterStartDelay"
                                Grid.Row="6">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="After Start delay, s" />
                        <TextBox Margin="0,5,0,0"
                                 Text="{Binding DelayAfterStartSeconds, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Phase}"
                             Value="BeforeStart">
                    <Setter TargetName="StepAfterStartDelay"
                            Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="Route" />
                    <TextBlock x:Name="FastRouteNameText"
                               Margin="0,9,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="Expedition · School Grounds" />
                </StackPanel>
                <Button x:Name="FastSaveButton"
                        Grid.Column="2"
                        Height="40"
                        VerticalAlignment="Bottom"
                        icons:Lucide.Icon="Save"
                        Content="Save setup"
                        Click="Save_Click" />
                <Grid Visibility="Collapsed">
                    <ComboBox x:Name="TargetModeCombo"
                              DisplayMemberPath="Label"
                              SelectionChanged="TargetModeCombo_SelectionChanged" />
                    <ComboBox x:Name="TargetMapCombo"
                              DisplayMemberPath="Label"
                              SelectionChanged="TargetRoute_SelectionChanged" />
                    <StackPanel x:Name="TargetVariantPanel">
                        <TextBlock x:Name="TargetVariantLabel"
                                   Text="Act" />
                        <ComboBox x:Name="TargetVariantCombo"
                                  DisplayMemberPath="Label"
                                  SelectionChanged="TargetRoute_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer x:Name="FastWorkspaceScrollViewer"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Disabled"
                      SizeChanged="WorkspaceViewport_SizeChanged">
        <Grid x:Name="FastWorkspaceGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FastMapColumn"
                                  Width="*" />
                <ColumnDefinition x:Name="FastWorkspaceColumnGap"
                                  Width="14" />
                <ColumnDefinition x:Name="FastStepsColumn"
                                  Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="FastMapRow"
                               Height="*" />
                <RowDefinition x:Name="FastWorkspaceRowGap"
                               Height="0" />
                <RowDefinition x:Name="FastStepsRow"
                               Height="0" />
            </Grid.RowDefinitions>

            <Grid x:Name="FastMapPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="PlacementScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="PlacementScrollViewer_PreviewMouseWheel"
                                      PreviewMouseDown="PlacementScrollViewer_PreviewMouseDown"
                                      PreviewMouseMove="PlacementScrollViewer_PreviewMouseMove"
                                      PreviewMouseUp="PlacementScrollViewer_PreviewMouseUp"
                                      LostMouseCapture="PlacementScrollViewer_LostMouseCapture">
                            <Grid x:Name="PlacementSurface"
                                  Width="808"
                                  Height="611"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource RaisedBrush}">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="PlacementZoomTransform" />
                                </Grid.LayoutTransform>
                                <Image x:Name="PlacementScreenshot"
                                       Width="808"
                                       Height="611"
                                       Stretch="Fill" />
                                <Canvas x:Name="PlacementCanvas"
                                        Width="808"
                                        Height="611"
                                        Background="Transparent"
                                        Cursor="Cross"
                                        MouseLeftButtonDown="PlacementCanvas_MouseLeftButtonDown">
                                    <ItemsControl x:Name="PlacementMarkers"
                                                  Width="808"
                                                  Height="611"
                                                  ItemTemplate="{StaticResource PlacementMarkerTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <Border Margin="10"
                                Padding="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource RaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Width="32" MinWidth="32" Height="32"
                                        icons:Lucide.Icon="Minus" ToolTip="Zoom out" Click="ZoomOut_Click" />
                                <Button x:Name="PlacementZoomButton" Margin="4,0" MinWidth="58" Height="32"
                                        Content="100%"
                                        ToolTip="Scroll to zoom. Hold the middle mouse button and drag to pan. Click to reset."
                                        Click="ResetZoom_Click" />
                                <Button Style="{StaticResource IconButton}" Width="32" MinWidth="32" Height="32"
                                        icons:Lucide.Icon="Plus" ToolTip="Zoom in" Click="ZoomIn_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <icons:PlacementRouteControls x:Name="FastRouteControls"
                                               Grid.Row="2" />
            </Grid>

            <Border x:Name="FastStepsPanel"
                    Grid.Column="2"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="FastStepsHeadingText"
                                   Style="{StaticResource SectionTitle}"
                                   Text="Placement steps" />
                        <TextBlock x:Name="FastPlacementCountText"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource Caption}"
                                   Text="0 before · 0 after" />
                    </StackPanel>
                    <ListBox x:Name="FastStepsList"
                             Grid.Row="2"
                             AllowDrop="True"
                             SelectionMode="Single"
                             ItemTemplate="{StaticResource PlacementStepTemplate}"
                             PreviewMouseLeftButtonUp="FastStepsList_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="FastStepsList_PreviewMouseMove"
                             DragOver="FastStepsList_DragOver"
                             DragLeave="FastStepsList_DragLeave"
                             Drop="FastStepsList_Drop" />
                    <TextBlock x:Name="FastManualRecordingHelp"
                               Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Caption}"
                               Text="Normal placement steps are preserved and return when manual recording is turned off."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                    <StackPanel Grid.Row="4"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="FastTimingButton"
                                Style="{StaticResource IconButton}"
                                Width="32"
                                MinWidth="32"
                                Height="32"
                                icons:Lucide.Icon="Settings"
                                AutomationProperties.Name="Placement settings"
                                ToolTip="Placement settings"
                                Click="FastTimingButton_Click" />
                        <Button x:Name="FastMoveUpButton"
                                Style="{StaticResource IconButton}"
                                Width="32"
                                MinWidth="32"
                                Height="32"
                                Margin="5,0,0,0"
                                icons:Lucide.Icon="ArrowUp"
                                AutomationProperties.Name="Move selected placement step up"
                                ToolTip="Move selected step up"
                                Click="MoveUp_Click" />
                        <Button x:Name="FastMoveDownButton"
                                Style="{StaticResource IconButton}"
                                Width="32"
                                MinWidth="32"
                                Height="32"
                                Margin="5,0,0,0"
                                icons:Lucide.Icon="ArrowDown"
                                AutomationProperties.Name="Move selected placement step down"
                                ToolTip="Move selected step down"
                                Click="MoveDown_Click" />
                        <Button x:Name="FastRemoveButton"
                                Style="{StaticResource IconButton}"
                                Width="32"
                                MinWidth="32"
                                Height="32"
                                Margin="5,0,0,0"
                                icons:Lucide.Icon="Trash2"
                                AutomationProperties.Name="Remove selected placement step"
                                ToolTip="Remove selected step"
                                Click="RemoveRow_Click" />
                    </StackPanel>
                    <Popup x:Name="FastTimingPopup"
                           AllowsTransparency="True"
                           Placement="Top"
                           PlacementTarget="{Binding ElementName=FastTimingButton}"
                           PopupAnimation="Fade"
                           StaysOpen="False"
                           VerticalOffset="-8">
                        <icons:PlacementTimingPopover x:Name="FastTimingEditor" />
                    </Popup>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <Grid x:Name="FastActionArea"
              Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="FastStatusPanel"
                        VerticalAlignment="Center">
                <TextBlock x:Name="FastStatusText"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="FastDetailText"
                           Visibility="Collapsed"
                           Style="{StaticResource Caption}" />
            </StackPanel>
            <WrapPanel x:Name="FastActionPanel"
                       Grid.Column="1"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center">
                <Button x:Name="FastPrepareButton"
                        icons:Lucide.Icon="ArrowDown"
                        Content="Fast align Roblox"
                        Click="FastPrepare_Click" />
                <Button x:Name="FastPositionButton"
                        Margin="8,0,0,0"
                        icons:Lucide.Icon="Route"
                        Content="Prepare recording start"
                        Visibility="Collapsed"
                        Click="FastPosition_Click" />
                <Button x:Name="FastTestButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        icons:Lucide.Icon="Play"
                        Content="Test playback"
                        Click="Test_Click" />
                <Button x:Name="FastStopButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource DangerButton}"
                        icons:Lucide.Icon="Square"
                        Content="Stop"
                        IsEnabled="False"
                        Click="Stop_Click" />
            </WrapPanel>
            <ProgressBar x:Name="FastOperationProgress"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Margin="0,12,0,0"
                         Minimum="0"
                         Maximum="100" />
        </Grid>

        <Border x:Name="SnapshotSettingsOverlay"
                Grid.RowSpan="5"
                Margin="0,0,8,52"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Panel.ZIndex="20"
                Visibility="Collapsed">
            <icons:PlacementTimingPopover x:Name="SnapshotTimingEditor" />
        </Border>
    </Grid>
</UserControl>
