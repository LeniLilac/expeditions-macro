<UserControl x:Class="ExpeditionsMacro.App.Controls.PlacementFastEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="PlacementMarkerTemplate">
            <Canvas Width="66"
                    Height="46"
                    Cursor="Hand"
                    ToolTip="Right-click to remove this placement"
                    MouseLeftButtonDown="PlacementMarker_MouseLeftButtonDown"
                    MouseRightButtonDown="PlacementMarker_MouseRightButtonDown">
                <Canvas.RenderTransform>
                    <TranslateTransform X="-8"
                                        Y="-38" />
                </Canvas.RenderTransform>
                <Path x:Name="MarkerConnector"
                      Data="M 8,34 L 8,12 L 18,12"
                      Stroke="{DynamicResource AccentBrush}"
                      StrokeThickness="3" />
                <Ellipse x:Name="MarkerPoint"
                         Canvas.Left="1"
                         Canvas.Top="27"
                         Width="14"
                         Height="14"
                         Fill="{DynamicResource SurfaceBrush}"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="4" />
                <Border x:Name="MarkerLabelBox"
                        Canvas.Left="18"
                        Canvas.Top="0"
                        MinWidth="36"
                        Height="24"
                        Padding="8,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2"
                        CornerRadius="3">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <TextBlock FontWeight="Bold"
                                   Text="{Binding MarkerLabel}" />
                        <TextBlock Margin="4,0,0,0"
                                   FontSize="9"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding PhaseShortLabel}" />
                    </StackPanel>
                </Border>
            </Canvas>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Phase}"
                             Value="AfterStart">
                    <Setter TargetName="MarkerConnector"
                            Property="Stroke"
                            Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="MarkerPoint"
                            Property="Stroke"
                            Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="MarkerLabelBox"
                            Property="BorderBrush"
                            Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="PlacementStepTemplate">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock FontWeight="SemiBold"
                               Text="{Binding UnitKey, StringFormat='Unit {0}'}" />
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="{Binding PhaseLabel}" />
                </Grid>
                <TextBlock Grid.Row="2"
                           Style="{StaticResource Caption}">
                    <TextBlock.Inlines>
                        <Run Text="Coordinate " />
                        <Run Text="{Binding X, Mode=OneWay}" />
                        <Run Text=", " />
                        <Run Text="{Binding Y, Mode=OneWay}" />
                    </TextBlock.Inlines>
                </TextBlock>
                <StackPanel x:Name="StepAfterStartDelay"
                            Grid.Row="4">
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="After Start delay, s" />
                    <TextBox Margin="0,5,0,0"
                             Text="{Binding DelayAfterStartSeconds, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Phase}"
                             Value="BeforeStart">
                    <Setter TargetName="StepAfterStartDelay"
                            Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="Route" />
                    <TextBlock x:Name="FastRouteNameText"
                               Margin="0,9,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="Expedition · School Grounds" />
                </StackPanel>
                <Button x:Name="FastSaveButton"
                        Grid.Column="2"
                        Height="40"
                        VerticalAlignment="Bottom"
                        icons:Lucide.Icon="Save"
                        Content="Save setup"
                        Click="Save_Click" />
                <Grid Visibility="Collapsed">
                    <ComboBox x:Name="TargetModeCombo"
                              DisplayMemberPath="Label"
                              SelectionChanged="TargetModeCombo_SelectionChanged" />
                    <ComboBox x:Name="TargetMapCombo"
                              DisplayMemberPath="Label"
                              SelectionChanged="TargetRoute_SelectionChanged" />
                    <StackPanel x:Name="TargetVariantPanel">
                        <TextBlock x:Name="TargetVariantLabel"
                                   Text="Act" />
                        <ComboBox x:Name="TargetVariantCombo"
                                  DisplayMemberPath="Label"
                                  SelectionChanged="TargetRoute_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="236" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid Width="808"
                              Height="611"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="{DynamicResource RaisedBrush}">
                            <Image x:Name="PlacementScreenshot"
                                   Width="808"
                                   Height="611"
                                   Stretch="Fill" />
                            <Canvas x:Name="PlacementCanvas"
                                    Width="808"
                                    Height="611"
                                    Background="Transparent"
                                    Cursor="Cross"
                                    MouseLeftButtonDown="PlacementCanvas_MouseLeftButtonDown">
                                <ItemsControl x:Name="PlacementMarkers"
                                              Width="808"
                                              Height="611"
                                              ItemTemplate="{StaticResource PlacementMarkerTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left"
                                                    Value="{Binding X}" />
                                            <Setter Property="Canvas.Top"
                                                    Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                </ItemsControl>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="2"
                        Padding="12"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Placement phase" />
                            <StackPanel Margin="0,7,0,0"
                                        Orientation="Horizontal">
                                <RadioButton x:Name="FastBeforeStartButton"
                                             GroupName="PlacementPhase"
                                             Style="{StaticResource PlacementChoiceButton}"
                                             Content="Before Start"
                                             Tag="BeforeStart"
                                             IsChecked="True"
                                             Checked="FastPhaseButton_Checked" />
                                <RadioButton x:Name="FastAfterStartButton"
                                             GroupName="PlacementPhase"
                                             Style="{StaticResource PlacementChoiceButton}"
                                             Content="After Start"
                                             Tag="AfterStart"
                                             Checked="FastPhaseButton_Checked" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Unit slot" />
                            <StackPanel Margin="0,7,0,0"
                                        Orientation="Horizontal">
                                <RadioButton x:Name="FastUnit1Button"
                                             GroupName="PlacementUnit"
                                             Style="{StaticResource PlacementChoiceButton}"
                                             Width="42"
                                             MinWidth="42"
                                             Padding="0"
                                             Content="1"
                                             Tag="1"
                                             IsChecked="True"
                                             Checked="FastUnitButton_Checked" />
                                <RadioButton x:Name="FastUnit2Button"
                                             GroupName="PlacementUnit"
                                             Style="{StaticResource PlacementChoiceButton}"
                                             Width="42"
                                             MinWidth="42"
                                             Padding="0"
                                             Content="2"
                                             Tag="2"
                                             Checked="FastUnitButton_Checked" />
                                <RadioButton x:Name="FastUnit3Button"
                                             GroupName="PlacementUnit"
                                             Style="{StaticResource PlacementChoiceButton}"
                                             Width="42"
                                             MinWidth="42"
                                             Padding="0"
                                             Content="3"
                                             Tag="3"
                                             Checked="FastUnitButton_Checked" />
                                <RadioButton x:Name="FastUnit4Button"
                                             GroupName="PlacementUnit"
                                             Style="{StaticResource PlacementChoiceButton}"
                                             Width="42"
                                             MinWidth="42"
                                             Padding="0"
                                             Content="4"
                                             Tag="4"
                                             Checked="FastUnitButton_Checked" />
                                <RadioButton x:Name="FastUnit5Button"
                                             GroupName="PlacementUnit"
                                             Style="{StaticResource PlacementChoiceButton}"
                                             Width="42"
                                             MinWidth="42"
                                             Padding="0"
                                             Content="5"
                                             Tag="5"
                                             Checked="FastUnitButton_Checked" />
                                <RadioButton x:Name="FastUnit6Button"
                                             GroupName="PlacementUnit"
                                             Style="{StaticResource PlacementChoiceButton}"
                                             Width="42"
                                             MinWidth="42"
                                             Padding="0"
                                             Content="6"
                                             Tag="6"
                                             Checked="FastUnitButton_Checked" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Team" />
                            <ComboBox x:Name="FastTeamCombo"
                                      Margin="0,7,0,0"
                                      DisplayMemberPath="Name" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Placement steps" />
                        <TextBlock x:Name="FastPlacementCountText"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource Caption}"
                                   Text="0 before · 0 after" />
                    </StackPanel>
                    <ListBox x:Name="FastStepsList"
                             Grid.Row="2"
                             SelectionMode="Single"
                             ItemTemplate="{StaticResource PlacementStepTemplate}" />
                    <StackPanel Grid.Row="4"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}"
                                Width="32"
                                MinWidth="32"
                                Height="32"
                                icons:Lucide.Icon="ArrowUp"
                                ToolTip="Move selected step up"
                                Click="MoveUp_Click" />
                        <Button Style="{StaticResource IconButton}"
                                Width="32"
                                MinWidth="32"
                                Height="32"
                                Margin="5,0,0,0"
                                icons:Lucide.Icon="ArrowDown"
                                ToolTip="Move selected step down"
                                Click="MoveDown_Click" />
                        <Button Style="{StaticResource IconButton}"
                                Width="32"
                                MinWidth="32"
                                Height="32"
                                Margin="5,0,0,0"
                                icons:Lucide.Icon="Trash2"
                                ToolTip="Remove selected step"
                                Click="RemoveRow_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FastStatusText"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="FastDetailText"
                           Visibility="Collapsed"
                           Style="{StaticResource Caption}" />
            </StackPanel>
            <WrapPanel Grid.Column="1"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center">
                <Button x:Name="FastPrepareButton"
                        icons:Lucide.Icon="ArrowDown"
                        Content="Fast align Roblox"
                        Click="FastPrepare_Click" />
                <Button x:Name="FastTestButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        icons:Lucide.Icon="Play"
                        Content="Test playback"
                        Click="Test_Click" />
                <Button x:Name="FastStopButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource DangerButton}"
                        icons:Lucide.Icon="Square"
                        Content="Stop"
                        IsEnabled="False"
                        Click="Stop_Click" />
            </WrapPanel>
            <ProgressBar x:Name="FastOperationProgress"
                         Grid.ColumnSpan="2"
                         Margin="0,52,0,0"
                         VerticalAlignment="Top"
                         Minimum="0"
                         Maximum="100" />
        </Grid>
    </Grid>
</UserControl>
