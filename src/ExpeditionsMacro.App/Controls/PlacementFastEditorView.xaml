<UserControl x:Class="ExpeditionsMacro.App.Controls.PlacementFastEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls"
             xmlns:models="clr-namespace:ExpeditionsMacro.App.Models"
             xmlns:core="clr-namespace:ExpeditionsMacro.Core.Models;assembly=ExpeditionsMacro.Core"
             SizeChanged="Editor_SizeChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="PlacementMarkerTemplate">
            <icons:PlacementMarkerView Cursor="Hand"
                                       ToolTip="Right-click to remove this match step"
                                       MouseLeftButtonDown="PlacementMarker_MouseLeftButtonDown"
                                       MouseRightButtonDown="PlacementMarker_MouseRightButtonDown" />
        </DataTemplate>
        <DataTemplate x:Key="PlacementStepTemplate">
            <Border Margin="0,0,0,6"
                    Padding="8"
                    Height="62"
                    VerticalAlignment="Top"
                    Background="{DynamicResource RaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid MinHeight="46">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ActionAccent"
                            Width="4"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource MatchStepPlacementBrush}"
                            CornerRadius="2" />
                    <Border Grid.Column="1"
                            Margin="-2,0,2,0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            ToolTip="Drag to reorder the timeline. Move Start Game to change when actions run."
                            PreviewMouseLeftButtonDown="StepDragHandle_PreviewMouseLeftButtonDown">
                        <icons:LucideIcon Width="14"
                                          Height="14"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource FaintBrush}"
                                          Icon="GripVertical" />
                    </Border>
                    <StackPanel Grid.Column="2"
                                Margin="2,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="StepTitleText"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MatchStepPlacementBrush}"
                                   Text="{Binding StepTitle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StepSecondaryText"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource Caption}"
                                   Text="{Binding CoordinateLabel}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel x:Name="StepSummaryPanel"
                                Grid.Column="3"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding ScheduleLabel}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Width="30"
                                MinWidth="30"
                                Height="30"
                                Style="{StaticResource IconButton}"
                                ToolTip="Edit match step"
                                AutomationProperties.Name="Edit match step"
                                IsEnabled="{Binding CanEdit}"
                                icons:Lucide.Icon="Settings"
                                Click="StepSettings_Click" />
                        <Button Width="30"
                                MinWidth="30"
                                Height="30"
                                Margin="5,0,0,0"
                                Style="{StaticResource IconButton}"
                                ToolTip="Move match step up"
                                AutomationProperties.Name="Move match step up"
                                icons:Lucide.Icon="ArrowUp"
                                Click="StepMoveUp_Click" />
                        <Button Width="30"
                                MinWidth="30"
                                Height="30"
                                Margin="5,0,0,0"
                                Style="{StaticResource IconButton}"
                                ToolTip="Move match step down"
                                AutomationProperties.Name="Move match step down"
                                icons:Lucide.Icon="ArrowDown"
                                Click="StepMoveDown_Click" />
                        <Button Width="30"
                                MinWidth="30"
                                Height="30"
                                Margin="5,0,0,0"
                                Style="{StaticResource IconButton}"
                                ToolTip="Remove match step"
                                AutomationProperties.Name="Remove match step"
                                IsEnabled="{Binding CanRemove}"
                                icons:Lucide.Icon="Trash2"
                                Click="StepRemove_Click" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static core:MatchStepKind.ReconfigureUnit}">
                    <Setter TargetName="ActionAccent"
                            Property="Background"
                            Value="{DynamicResource MatchStepReconfigureBrush}" />
                    <Setter TargetName="StepTitleText"
                            Property="Foreground"
                            Value="{DynamicResource MatchStepReconfigureBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static core:MatchStepKind.StartGame}">
                    <Setter TargetName="ActionAccent"
                            Property="Background"
                            Value="{DynamicResource MatchStepStartBrush}" />
                    <Setter TargetName="StepTitleText"
                            Property="Foreground"
                            Value="{DynamicResource MatchStepStartBrush}" />
                    <Setter TargetName="StepSecondaryText"
                            Property="Visibility"
                            Value="Collapsed" />
                    <Setter TargetName="StepSummaryPanel"
                            Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static core:MatchStepKind.Delay}">
                    <Setter TargetName="ActionAccent"
                            Property="Background"
                            Value="{DynamicResource MatchStepDelayBrush}" />
                    <Setter TargetName="StepTitleText"
                            Property="Foreground"
                            Value="{DynamicResource MatchStepDelayBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static core:MatchStepKind.UpgradeUnit}">
                    <Setter TargetName="ActionAccent"
                            Property="Background"
                            Value="{DynamicResource MatchStepUpgradeBrush}" />
                    <Setter TargetName="StepTitleText"
                            Property="Foreground"
                            Value="{DynamicResource MatchStepUpgradeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static core:MatchStepKind.SellUnit}">
                    <Setter TargetName="ActionAccent"
                            Property="Background"
                            Value="{DynamicResource ErrorBrush}" />
                    <Setter TargetName="StepTitleText"
                            Property="Foreground"
                            Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="FastRouteIdentityPanel">
                    <TextBlock Style="{StaticResource FieldLabel}"
                               Text="Route" />
                    <TextBlock x:Name="FastRouteNameText"
                               Margin="0,9,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="Expedition · School Grounds" />
                </StackPanel>
                <icons:PlacementPlaybackModeSelector x:Name="FastPlaybackModeSelector"
                                                     Grid.Column="1"
                                                     Margin="24,0,0,0"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Center"
                                                     Visibility="Collapsed" />
                <Grid Visibility="Collapsed">
                    <ComboBox x:Name="TargetModeCombo"
                              DisplayMemberPath="Label"
                              SelectionChanged="TargetModeCombo_SelectionChanged" />
                    <ComboBox x:Name="TargetMapCombo"
                              DisplayMemberPath="Label"
                              SelectionChanged="TargetRoute_SelectionChanged" />
                    <StackPanel x:Name="TargetVariantPanel">
                        <TextBlock x:Name="TargetVariantLabel"
                                   Text="Act" />
                        <ComboBox x:Name="TargetVariantCombo"
                                  DisplayMemberPath="Label"
                                  SelectionChanged="TargetRoute_SelectionChanged" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer x:Name="FastWorkspaceScrollViewer"
                      Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      SizeChanged="WorkspaceViewport_SizeChanged">
        <Grid x:Name="FastWorkspaceGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="FastMapPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="PlacementScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="PlacementScrollViewer_PreviewMouseWheel"
                                      PreviewMouseDown="PlacementScrollViewer_PreviewMouseDown"
                                      PreviewMouseMove="PlacementScrollViewer_PreviewMouseMove"
                                      PreviewMouseUp="PlacementScrollViewer_PreviewMouseUp"
                                      LostMouseCapture="PlacementScrollViewer_LostMouseCapture">
                            <Grid x:Name="PlacementSurface"
                                  Width="808"
                                  Height="611"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Background="{DynamicResource RaisedBrush}">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="PlacementZoomTransform" />
                                </Grid.LayoutTransform>
                                <Image x:Name="PlacementScreenshot"
                                       Width="808"
                                       Height="611"
                                       Stretch="Fill" />
                                <Canvas x:Name="PlacementCanvas"
                                        Width="808"
                                        Height="611"
                                        Background="Transparent"
                                        Cursor="Cross"
                                        MouseLeftButtonDown="PlacementCanvas_MouseLeftButtonDown">
                                    <ItemsControl x:Name="PlacementMarkers"
                                                  Width="808"
                                                  Height="611"
                                                  ItemTemplate="{StaticResource PlacementMarkerTemplate}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding MarkerLayout.CanvasLeft}" />
                                                <Setter Property="Canvas.Top" Value="{Binding MarkerLayout.CanvasTop}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                    </ItemsControl>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <Border Margin="10"
                                Padding="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource RaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Width="32" MinWidth="32" Height="32"
                                        icons:Lucide.Icon="Minus" ToolTip="Zoom out" Click="ZoomOut_Click" />
                                <Button x:Name="PlacementZoomButton" Margin="4,0" MinWidth="58" Height="32"
                                        Content="100%"
                                        ToolTip="Scroll to zoom. Hold the middle mouse button and drag to pan. Click to reset."
                                        Click="ResetZoom_Click" />
                                <Button Style="{StaticResource IconButton}" Width="32" MinWidth="32" Height="32"
                                        icons:Lucide.Icon="Plus" ToolTip="Zoom in" Click="ZoomIn_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <icons:PlacementRouteControls x:Name="FastRouteControls"
                                               Grid.Row="2" />
            </Grid>

            <Border x:Name="FastStepsPanel"
                    Grid.Row="2"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="FastStepsHeadingText"
                                       Style="{StaticResource SectionTitle}"
                                       Text="Match steps" />
                            <TextBlock x:Name="FastPlacementCountText"
                                       Margin="0,3,0,0"
                                       Style="{StaticResource Caption}"
                                       Text="1 required Start Game step" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <Button x:Name="FastAddStepButton"
                                    Height="32"
                                    icons:Lucide.Icon="Plus"
                                    Content="Add action"
                                    ToolTip="Add a delay, reconfigure, upgrade, or placement action"
                                    Click="AddStep_Click" />
                            <Button x:Name="FastTimingButton"
                                    Width="32"
                                    MinWidth="32"
                                    Height="32"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource IconButton}"
                                    icons:Lucide.Icon="Settings"
                                    AutomationProperties.Name="Match settings"
                                    ToolTip="Match settings"
                                    Click="FastTimingButton_Click" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="FastStepsList"
                             Grid.Row="2"
                             AllowDrop="True"
                             HorizontalContentAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False"
                             SelectionMode="Single"
                             ItemTemplate="{StaticResource PlacementStepTemplate}"
                             PreviewMouseWheel="FastStepsList_PreviewMouseWheel"
                             PreviewMouseLeftButtonUp="FastStepsList_PreviewMouseLeftButtonUp"
                             PreviewMouseMove="FastStepsList_PreviewMouseMove"
                             DragOver="FastStepsList_DragOver"
                             DragLeave="FastStepsList_DragLeave"
                             Drop="FastStepsList_Drop" />
                    <TextBlock x:Name="FastManualRecordingHelp"
                               Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{StaticResource Caption}"
                               Text="Normal match steps are preserved and return in Step Mode."
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <Grid x:Name="FastActionArea"
              Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="FastStatusPanel"
                        VerticalAlignment="Center">
                <TextBlock x:Name="FastStatusText"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="FastDetailText"
                           Visibility="Collapsed"
                           Style="{StaticResource Caption}" />
            </StackPanel>
            <WrapPanel x:Name="FastActionPanel"
                       Grid.Column="1"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center">
                <Button x:Name="FastPrepareButton"
                        icons:Lucide.Icon="ArrowDown"
                        Content="Fast align Roblox"
                        Click="FastPrepare_Click" />
                <Button x:Name="FastPositionButton"
                        Margin="8,0,0,0"
                        icons:Lucide.Icon="Route"
                        Content="Prepare recording start"
                        Visibility="Collapsed"
                        Click="FastPosition_Click" />
                <Button x:Name="FastTestButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        icons:Lucide.Icon="Play"
                        Content="Test playback"
                        Click="Test_Click" />
                <Button x:Name="FastStopButton"
                        Margin="8,0,0,0"
                        Style="{StaticResource DangerButton}"
                        icons:Lucide.Icon="Square"
                        Content="Stop"
                        IsEnabled="False"
                        Click="Stop_Click" />
            </WrapPanel>
            <ProgressBar x:Name="FastOperationProgress"
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         Margin="0,12,0,0"
                         Minimum="0"
                         Maximum="100" />
        </Grid>
    </Grid>
</UserControl>
