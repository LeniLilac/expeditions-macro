<UserControl x:Class="ExpeditionsMacro.App.Controls.PlacementTimingPopover"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340"
             MaxHeight="620"
             FontFamily="{StaticResource UiFont}"
             Foreground="{DynamicResource TextBrush}">
    <Border Padding="16"
            Background="{DynamicResource RaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}"
                       Text="Placement settings" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource Caption}"
                       Text="Saved with this placement setup." />

            <StackPanel x:Name="PlacementTimingFieldsPanel">
                <TextBlock Margin="0,16,0,0"
                           Style="{StaticResource FieldLabel}"
                           Text="Between placements, ms" />
                <TextBox x:Name="PlacementIntervalText"
                         Margin="0,6,0,0"
                         AutomationProperties.Name="Delay between placements in milliseconds" />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource Caption}"
                           Text="Updates every step in this setup."
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource FieldLabel}"
                           Text="Default After Start delay, s" />
                <TextBox x:Name="DefaultAfterStartDelayText"
                         Margin="0,6,0,0"
                         AutomationProperties.Name="Default After Start delay in seconds" />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource Caption}"
                           Text="Used for new steps. Existing custom delays stay unchanged."
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Margin="0,14,0,0"
                       Style="{StaticResource FieldLabel}"
                       Text="Impossibility threshold, min" />
            <TextBox x:Name="ImpossibilityThresholdText"
                     Margin="0,6,0,0"
                     AutomationProperties.Name="Impossibility threshold in minutes" />
            <TextBlock Margin="0,5,0,0"
                       Style="{StaticResource Caption}"
                       Text="0 uses the route default. Recovery starts if Victory or Defeat is not seen by this time."
                       TextWrapping="Wrap" />

            <Border x:Name="ManualRecordingPanel"
                    Margin="0,14,0,0"
                    Padding="0,13,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <CheckBox x:Name="UseManualRecordingCheck"
                              Content="Use manual recording"
                              Checked="UseManualRecordingCheck_Changed"
                              Unchecked="UseManualRecordingCheck_Changed" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource Caption}"
                               Text="Choose the recording from the main Placement Setup controls. Playback replaces normal steps and includes clicking Start Game; existing steps are preserved."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TimingErrorText"
                       Margin="0,10,0,0"
                       Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Button Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    Content="Apply"
                    Click="Apply_Click" />
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
