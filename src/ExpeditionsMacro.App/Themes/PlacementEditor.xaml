        </Setter>
    </Style>

    <Style x:Key="PlacementBinaryChoiceButton"
           TargetType="CheckBox">
        <Setter Property="Width" Value="116" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground"
                Value="{DynamicResource TextBrush}" />
        <Setter Property="Background"
                Value="{DynamicResource RaisedBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource BorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsThreeState" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="ChoiceFrame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid Margin="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="OffChoice"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="3,0,0,3" />
                            <Border x:Name="OnChoice"
                                    Grid.Column="1"
                                    CornerRadius="0,3,3,0" />
                            <Border Grid.Column="1"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,0,0,0"
                                    IsHitTestVisible="False" />
                            <TextBlock x:Name="OffLabel"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource OnAccentBrush}"
                                       Text="Off" />
                            <TextBlock x:Name="OnLabel"
                                       Grid.Column="1"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="On" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ChoiceFrame"
                                    Property="Background"
                                    Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="OffChoice"
                                    Property="Background"
                                    Value="Transparent" />
                            <Setter TargetName="OffLabel"
                                    Property="Foreground"
                                    Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="OnChoice"
                                    Property="Background"
                                    Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="OnLabel"
                                    Property="Foreground"
                                    Value="{DynamicResource OnAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="ChoiceFrame"
                                    Property="BorderBrush"
                                    Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ChoiceFrame"
                                    Property="Opacity"
                                    Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter Property="Opacity"
                                    Value="0.45" />
                            <Setter Property="Cursor"
                                    Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
