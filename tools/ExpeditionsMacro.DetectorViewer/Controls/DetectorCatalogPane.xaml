<UserControl x:Class="ExpeditionsMacro.DetectorViewer.Controls.DetectorCatalogPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.DetectorViewer.Controls">
    <Border Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="16,16,16,10">
                <TextBlock Style="{StaticResource SectionTitle}"
                           Text="Detector catalog" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Caption}"
                           Text="Production entry points are grouped by the screen or workflow they own." />
            </StackPanel>
            <Grid Grid.Row="1"
                  Margin="16,0,16,12">
                <TextBox x:Name="SearchBox"
                         Padding="34,0,10,0"
                         ToolTip="Search detectors"
                         TextChanged="SearchBox_TextChanged" />
                <icons:ViewerIconControl Width="15"
                                         Height="15"
                                         Margin="11,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource FaintBrush}"
                                         Icon="Search" />
                <TextBlock x:Name="SearchPlaceholder"
                           Margin="34,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource FaintBrush}"
                           IsHitTestVisible="False"
                           Text="Search detectors" />
            </Grid>
            <ListBox x:Name="CatalogList"
                     Grid.Row="2"
                     SelectionChanged="CatalogList_SelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Padding="16,12,16,7"
                                        Background="{DynamicResource SidebarBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,10"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Name}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,8,0"
                                               MaxHeight="36"
                                               Style="{StaticResource Caption}"
                                               Text="{Binding Description}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Padding="6,3"
                                        Height="23"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource RaisedBrush}"
                                        CornerRadius="3">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Text="{Binding DetailLabel}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="3"
                    Padding="16,10"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <CheckBox x:Name="IncludeUnavailableCheckBox"
                              IsChecked="True"
                              Content="Show unavailable detail hooks"
                              Checked="Filter_Changed"
                              Unchecked="Filter_Changed" />
                    <TextBlock x:Name="CountText"
                               Margin="0,6,0,0"
                               Style="{StaticResource Caption}"
                               Text="0 detectors" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
