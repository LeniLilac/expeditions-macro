<UserControl x:Class="ExpeditionsMacro.DetectorViewer.Controls.AnnotationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource SurfaceBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,18">
                <TextBlock Style="{StaticResource SectionTitle}"
                           Text="Detector annotations" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Caption}"
                           Text="Draw canonical regions and record the expected detector result." />

                <Border Margin="0,14,0,0"
                        Padding="10,8"
                        Background="{DynamicResource RaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock x:Name="AnnotationStatusText"
                               Style="{StaticResource Caption}"
                               Text="Open repository datasets to annotate fixtures." />
                </Border>

                <StackPanel x:Name="EditorPanel"
                            Margin="0,16,0,0"
                            IsEnabled="False">
                    <TextBlock Foreground="{DynamicResource MutedBrush}"
                               Text="Detector" />
                    <TextBlock x:Name="DetectorNameText"
                               Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Text="No detector selected" />

                    <TextBlock Margin="0,16,0,5"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="Expected result" />
                    <ComboBox x:Name="ExpectedResultBox"
                              SelectionChanged="ExpectedResultBox_SelectionChanged" />

                    <TextBlock Margin="0,16,0,5"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="Implementation notes" />
                    <TextBox x:Name="NotesTextBox"
                             Height="84"
                             Padding="10,8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             TextChanged="NotesTextBox_TextChanged" />

                    <Grid Margin="0,18,0,6">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Detection regions" />
                        <TextBlock x:Name="RegionCountText"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource Caption}"
                                   Text="0 regions" />
                    </Grid>
                    <TextBlock Margin="0,0,0,8"
                               Style="{StaticResource Caption}"
                               Text="Drag on the image to add a region." />
                    <ListBox x:Name="RegionList"
                             MinHeight="92"
                             MaxHeight="190"
                             SelectionChanged="RegionList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,1">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource MonospaceCaption}"
                                               Text="{Binding CoordinateSummary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid x:Name="RegionEditor"
                          Margin="0,10,0,0"
                          IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RegionLabelTextBox"
                                 ToolTip="Region label"
                                 LostFocus="RegionLabelTextBox_LostFocus" />
                        <Button Grid.Column="1"
                                Width="82"
                                Margin="8,0,0,0"
                                Content="Delete"
                                Click="DeleteRegion_Click" />
                    </Grid>
                    <TextBlock x:Name="SelectedCoordinatesText"
                               Margin="0,6,0,0"
                               Style="{StaticResource MonospaceCaption}"
                               Text="Select a region to edit it." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
