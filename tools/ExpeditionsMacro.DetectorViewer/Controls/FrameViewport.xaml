<UserControl x:Class="ExpeditionsMacro.DetectorViewer.Controls.FrameViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.DetectorViewer.Controls">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <Border Padding="12,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="PreviousButton"
                            Style="{StaticResource IconButton}"
                            ToolTip="Previous frame (Left)"
                            Click="PreviousButton_Click"
                            icons:ViewerIcon.Icon="ChevronLeft" />
                    <Button x:Name="NextButton"
                            Margin="6,0,0,0"
                            Style="{StaticResource IconButton}"
                            ToolTip="Next frame (Right)"
                            Click="NextButton_Click"
                            icons:ViewerIcon.Icon="ChevronRight" />
                </StackPanel>
                <StackPanel x:Name="FrameIdentity"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Orientation="Horizontal">
                    <TextBlock x:Name="FrameNumberText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="No frame" />
                    <TextBlock x:Name="FrameNameText"
                               Margin="10,0,0,0"
                               MaxWidth="240"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource FaintBrush}"
                               Text="Open an image source to begin"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <CheckBox x:Name="GeometryCheckBox"
                              IsChecked="True"
                              Content="Geometry"
                              Checked="OverlayOption_Changed"
                              Unchecked="OverlayOption_Changed" />
                    <CheckBox x:Name="LabelsCheckBox"
                              Margin="14,0,0,0"
                              IsChecked="True"
                              Content="Labels"
                              Checked="OverlayOption_Changed"
                              Unchecked="OverlayOption_Changed" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="12"
                Background="{DynamicResource ImageWellBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <ScrollViewer x:Name="ImageScroller"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="ImageScroller_PreviewMouseWheel"
                              PreviewMouseDown="ImageScroller_PreviewMouseDown"
                              PreviewMouseMove="ImageScroller_PreviewMouseMove"
                              PreviewMouseUp="ImageScroller_PreviewMouseUp">
                    <Grid x:Name="ImageContent"
                          Width="808"
                          Height="611"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Background="#050606"
                          MouseMove="ImageContent_MouseMove"
                          MouseLeave="ImageContent_MouseLeave">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ImageScale"
                                            ScaleX="1"
                                            ScaleY="1" />
                        </Grid.LayoutTransform>
                        <Image x:Name="FrameImage"
                               Width="{Binding ActualWidth, ElementName=ImageContent}"
                               Height="{Binding ActualHeight, ElementName=ImageContent}"
                               Stretch="Fill"
                               SnapsToDevicePixels="True" />
                        <Canvas x:Name="OverlayCanvas"
                                Width="{Binding ActualWidth, ElementName=ImageContent}"
                                Height="{Binding ActualHeight, ElementName=ImageContent}"
                                IsHitTestVisible="False" />
                    </Grid>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState"
                            Width="330"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <icons:ViewerIconControl Width="28"
                                             Height="28"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource FaintBrush}"
                                             Icon="Image" />
                    <TextBlock x:Name="EmptyTitleText"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SectionTitle}"
                               Text="No capture open" />
                    <TextBlock x:Name="EmptyMessageText"
                               Margin="0,5,0,0"
                               TextAlignment="Center"
                               Style="{StaticResource Caption}"
                               Text="Open a PNG, image folder, or Deep Debug ZIP. Frames are inspected locally." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="14,10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Slider x:Name="FrameSlider"
                        Minimum="0"
                        Maximum="0"
                        ValueChanged="FrameSlider_ValueChanged" />
                <Grid Grid.Row="1"
                      Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TimestampText"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource MonospaceCaption}"
                               Text="Timestamp unavailable"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Zoom out"
                                Click="ZoomOut_Click"
                                icons:ViewerIcon.Icon="ZoomOut" />
                        <TextBlock x:Name="ZoomText"
                                   Width="56"
                                   VerticalAlignment="Center"
                                   Text="100%"
                                   TextAlignment="Center" />
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Zoom in"
                                Click="ZoomIn_Click"
                                icons:ViewerIcon.Icon="ZoomIn" />
                        <Button Margin="7,0,0,0"
                                Content="Fit"
                                ToolTip="Fit frame to viewport (F)"
                                Click="FitButton_Click"
                                icons:ViewerIcon.Icon="Maximize" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
