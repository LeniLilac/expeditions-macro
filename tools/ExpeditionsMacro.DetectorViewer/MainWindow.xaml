<Window x:Class="ExpeditionsMacro.DetectorViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExpeditionsMacro.DetectorViewer.Controls"
        xmlns:icons="clr-namespace:ExpeditionsMacro.DetectorViewer.Controls"
        Title="Detector Viewer"
        Width="1480"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/ExpeditionsMacro.DetectorViewer;component/Resources/app.ico"
        Style="{StaticResource AppWindow}"
        AllowDrop="True"
        Closed="Window_Closed"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Padding="20,0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}"
                               Text="Detector Viewer" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Inspect production evidence against canonical game captures." />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Margin="28,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="SourcePathText"
                               MaxWidth="540"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="No image source open"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="SourceSummaryText"
                               Margin="0,2,0,0"
                               MaxWidth="280"
                               HorizontalAlignment="Right"
                               Style="{StaticResource Caption}"
                               Text="PNG, image folder, or Deep Debug ZIP"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Content="Open source"
                            Style="{StaticResource PrimaryButton}"
                            Click="OpenSource_Click"
                            icons:ViewerIcon.Icon="FolderOpen" />
                    <Button Margin="0,0,8,0"
                            Content="Open folder"
                            Click="OpenFolder_Click"
                            icons:ViewerIcon.Icon="Folder" />
                    <Button x:Name="ThemeButton"
                            Width="104"
                            Content="Dark"
                            Click="ThemeButton_Click"
                            ToolTip="Switch viewer theme"
                            icons:ViewerIcon.Icon="Moon" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"
                                  MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*"
                                  MinWidth="320" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="420"
                                  MinWidth="350" />
            </Grid.ColumnDefinitions>
            <controls:DetectorCatalogPane x:Name="CatalogPane"
                                          SelectedDetectorChanged="CatalogPane_SelectedDetectorChanged" />
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />
            <controls:FrameViewport x:Name="Viewport"
                                    Grid.Column="2"
                                    FrameIndexRequested="Viewport_FrameIndexRequested"
                                    PixelHovered="Viewport_PixelHovered"
                                    PixelExited="Viewport_PixelExited" />
            <GridSplitter Grid.Column="3"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />
            <controls:EvidencePane x:Name="EvidencePane"
                                   Grid.Column="4"
                                   SelectedCheckChanged="EvidencePane_SelectedCheckChanged" />
        </Grid>

        <Border Grid.Row="2"
                Padding="14,0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"
                           Text="Ready" />
                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border x:Name="PixelSwatch"
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" />
                    <TextBlock x:Name="PixelText"
                               VerticalAlignment="Center"
                               Style="{StaticResource MonospaceCaption}"
                               Text="Move over the image for pixel details" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
